# ============================================================
# EDUPLAN Class — Environment Variables Example
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Google Cloud Console
# (ห้ามนำไฟล์ .env ขึ้น Git เด็ดขาด — .gitignore บล็อกไว้แล้ว)
# ============================================================

# OAuth 2.0 Client ID (Web application) จาก Google Cloud Console
# ต้องตั้งค่า Authorized JavaScript origins (เช่น http://localhost:5173 หรือ https://<user>.github.io)
VITE_GOOGLE_CLIENT_ID=

# API Key จาก Google Cloud Console (ควรจำกัดสิทธิ์ HTTP Referrer และจำกัดเฉพาะ Picker API / Sheets API)
VITE_GOOGLE_API_KEY=
